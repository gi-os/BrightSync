LIGHTSYNC_TOKEN=change-me

# Work-calendar bridge (optional — leave GRAPH_CLIENT_ID empty and it stays dormant).
# GRAPH_CLIENT_ID is the Azure app registration's application id: a public client, no
# secret, delegated Calendars.Read, "allow public client flows" turned on.
GRAPH_CLIENT_ID=
# The tenant to sign in against. A specific tenant id is stricter than "organizations".
GRAPH_TENANT=organizations
# The unguessable path segment the .ics is served under. This URL is the credential:
# anyone holding it can read the calendar. Generate with `openssl rand -hex 24`.
CALENDAR_SECRET=
CALENDAR_NAME=Work
