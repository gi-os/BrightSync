LIGHTSYNC_TOKEN=change-me

# Work-calendar bridge (optional — leave GRAPH_CLIENT_ID empty and it stays dormant).
# GRAPH_CLIENT_ID is the Azure app registration's application id: a public client, no
# secret, delegated Calendars.Read, "allow public client flows" turned on.
GRAPH_CLIENT_ID=
# The tenant to sign in against. A specific tenant id is stricter than "organizations".
GRAPH_TENANT=organizations
# The unguessable path segment the .ics is served under. This URL is the credential:
# anyone holding it can read the calendar. Generate with `openssl rand -hex 24`.
CALENDAR_SECRET=
CALENDAR_NAME=Work

# The setup page, at http://192.168.68.59:8099/enroll/<LIGHTSYNC_TOKEN>. Open it on a computer
# and scan the QR with the phone.
LIGHTSYNC_PHONE_URL=http://192.168.68.59:8099
IMMICH_URL=http://192.168.68.59:2283
# An Immich API key with upload, read and album rights — not `all`.
IMMICH_KEY=
IMMICH_ALBUM=Light Phone III
# Put the encryption passphrase in the QR as well, so one scan finishes setup. Read the note in
# enroll.py first: setting this means this container can decrypt every backup it stores, which
# is the one thing the blob store is designed not to be able to do. Empty is the default, and
# the phone then asks for the passphrase once.
ENROLL_PASSPHRASE=
