# The phone's photographs and Immich's database, both on the NVMe volume rather than the RAID5
# pool. Postgres on spinning disks is what makes an Immich instance feel broken, and the library
# is small next to what is already on volume1.
UPLOAD_LOCATION=/volume2/immich/library
DB_DATA_LOCATION=/volume2/immich/postgres

TZ=America/New_York

# `v3` follows the current major. Pin an exact tag (e.g. v3.1.0) before going away for a week.
IMMICH_VERSION=v3

# Local to the compose network — Postgres is never published. Generate with `openssl rand -hex 16`.
DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
